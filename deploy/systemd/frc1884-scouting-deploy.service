[Unit]
Description=Build frc1884-scouting as its unprivileged deploy account
After=network-online.target
Requires=agent-secret-env@scouting-controller.service
After=agent-secret-env@scouting-controller.service

[Service]
Type=oneshot
User=frc1884-scouting-deploy
Group=frc1884-scouting-deploy
SupplementaryGroups=frc1884-scouting-trigger
WorkingDirectory=/srv/frc1884-scouting
Environment=HOME=/var/cache/frc1884-scouting-deploy
# ProcSubset hides CPU discovery; Wireit supports an explicit positive limit.
Environment=WIREIT_PARALLEL=1
EnvironmentFile=/etc/frc1884-scouting/controller.env
EnvironmentFile=/run/agent-app-secrets/scouting-controller/env
ExecStart=/usr/local/libexec/frc1884-scouting/deploy-jpclawhq.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
UMask=0027
TemporaryFileSystem=/srv:ro /opt:ro /var/lib:ro /var/cache:ro
InaccessiblePaths=-/run/agent-app-secrets -/run/openclaw -/run/openclaw-prod -/run/agent-ssh-995 -/run/agent-ssh-1000 -/run/agent-1password
CacheDirectory=frc1884-scouting-deploy
CacheDirectoryMode=0700
BindPaths=/srv/frc1884-scouting /var/cache/frc1884-scouting-deploy /var/lib/frc1884-scouting-request /var/lib/frc1884-scouting-activate
UMask=0022
TimeoutStartSec=30min
