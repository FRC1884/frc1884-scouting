[Unit]
Description=FRC 1884 Scouting Controller
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=frc1884-scouting
Group=frc1884-scouting
WorkingDirectory=/srv/frc1884-scouting
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3011
EnvironmentFile=/etc/frc1884-scouting/controller.env
ExecStart=/usr/bin/node /srv/frc1884-scouting/apps/controller/dist/src/server.js
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
UMask=0027
TemporaryFileSystem=/srv:ro /opt:ro /var/lib:ro /var/cache:ro
InaccessiblePaths=-/run/agent-app-secrets -/run/openclaw -/run/openclaw-prod -/run/agent-ssh-995 -/run/agent-ssh-1000 -/run/agent-1password
BindReadOnlyPaths=/srv/frc1884-scouting
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
