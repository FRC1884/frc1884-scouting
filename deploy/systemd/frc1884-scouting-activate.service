[Unit]
Description=Activate the fixed frc1884-scouting runtime

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/rm -f /var/lib/frc1884-scouting-activate/ready
ExecStart=/usr/bin/systemctl restart frc1884-scouting-controller.service
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/frc1884-scouting-activate
